{
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/.next-*": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "data": true,
    "dist": true,
    "docs/archive": true,
    "docs/local": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.next*/**": true,
    "data/**": true,
    "dist/**": true,
    "docs/archive/**": true,
    "docs/local/**": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.next*/**": true,
    "**/data/**": true
  }
}
