{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-production/types/**/*.ts",
    ".next-production/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-release-v2/types/**/*.ts",
    ".next-release-v2/dev/types/**/*.ts",
    ".next-learning-registry/types/**/*.ts",
    ".next-learning-registry/dev/types/**/*.ts",
    ".next-advanced-serving/types/**/*.ts",
    ".next-advanced-serving/dev/types/**/*.ts",
    ".next-learning-complete/types/**/*.ts",
    ".next-learning-complete/dev/types/**/*.ts",
    ".next-learning-final-verified/types/**/*.ts",
    ".next-learning-final-verified/dev/types/**/*.ts",
    ".next-real-research/types/**/*.ts",
    ".next-real-research/dev/types/**/*.ts",
    ".next-real-positive/types/**/*.ts",
    ".next-real-positive/dev/types/**/*.ts",
    ".next-real-finalized/types/**/*.ts",
    ".next-real-finalized/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
